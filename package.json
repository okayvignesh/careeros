{
  "name": "career-os",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "docker:up": "pnpm --filter '@careeros/shared' --filter '@careeros/secrets' --filter '@careeros/auth' --filter '@careeros/ai' build && docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml up -d --build",
    "docker:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml down",
    "docker:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml logs -f",
    "docker:ps": "docker compose --env-file .env -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.override.yml ps",
    "migrate": "pnpm --filter @careeros/api prisma migrate deploy",
    "migrate:dev": "pnpm --filter @careeros/api prisma migrate dev",
    "db:reset": "pnpm --filter @careeros/api prisma migrate reset --force"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0"
    }
  }
}
