# Career OS: copy to .env and fill in.
#
# A-H9: every secret below must be a fresh random value. Compose refuses to
# start if any required var is missing (`${VAR:?...}` syntax in
# docker-compose.yml), and startup-check.ts refuses to boot the api if any
# datastore password is short (< 24 bytes) or matches a known-weak default.
# Generate:
#
#   openssl rand -base64 32   # for POSTGRES_PASSWORD + MINIO_ROOT_PASSWORD
#   openssl rand -hex 32      # for ENCRYPTION_KEY + SESSION_SECRET

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development

# ─── Postgres (REQUIRED; no defaults, refuses on weak) ─────
POSTGRES_USER=careeros
POSTGRES_DB=careeros
POSTGRES_PASSWORD=REPLACE_ME_WITH_openssl_rand_base64_32
# Assembled from the values above; keep the password in sync.
DATABASE_URL=postgresql://careeros:REPLACE_ME_WITH_openssl_rand_base64_32@postgres:5432/careeros?schema=public

# ─── Redis / Qdrant ─────────────────────────────────────────
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# ─── Embeddings ─────────────────────────────────────────────
# local (default): `bge-small-en-v1.5` via @xenova/transformers. Downloads model
#   weights from Hugging Face on first use; if the model is missing/offline the
#   api logs a warning and degrades to the deterministic embedder (never crashes).
# deterministic: SHA-256 fallback vector, never touches the network (offline/CI).
# external: pluggable hosted adapter, configured in the setup wizard.
EMBEDDING_MODE=local
# Where local model weights are cached. Defaults to the library cache; point at a
# mounted volume in Docker so weights survive container restarts.
# EMBEDDING_MODEL_CACHE_DIR=/data/models

# ─── MinIO (REQUIRED; no defaults, refuses on weak) ────────
MINIO_ROOT_USER=careeros
MINIO_ROOT_PASSWORD=REPLACE_ME_WITH_openssl_rand_base64_32
MINIO_BUCKET=careeros

# ─── App secrets (REQUIRED; startup-check refuses if weak) ─
# Both must be ≥32 bytes and not equal to any known example value.
ENCRYPTION_KEY=REPLACE_ME_WITH_openssl_rand_hex_32
SESSION_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32

# ─── App ────────────────────────────────────────────────────
API_PORT=3001
WEB_PORT=3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000

# ─── Cookie session ─────────────────────────────────────────
# A-M1: cookie name is hard-coded (`__Host-careeros_session` in prod,
# `careeros_session` in dev). Env override was removed on purpose.
SESSION_TTL_HOURS=168

# ─── AI (wizard captures at runtime; no key needed at boot) ─
# DEEPSEEK_API_KEY=  # optional; otherwise entered in setup wizard

# ─── Job sources (optional; no key needed at boot) ─────────
# FIRECRAWL_API_KEY=  # optional; enables Firecrawl search/scrape/crawl of
#                     # public career sites + ATS boards. Without it the source
#                     # is reported unavailable; boot does not fail.

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DEBUG=

# ─── Public entrypoint: nginx + TLS (see infra/nginx/README.md) ──
# SERVER_NAME is the public DNS name nginx answers on (server_name) and the CN
# of the local self-signed dev cert. Default localhost works with no domain.
SERVER_NAME=localhost
# Host ports published by the nginx service.
HTTP_PORT=80
HTTPS_PORT=443
# TLS cert/key paths INSIDE the nginx container. Defaults are the self-signed
# files written by ./infra/nginx/self-signed.sh (bind-mounted from
# infra/nginx/certs). For real certs, point these at the certbot volume after
# `certbot certonly`:
#   TLS_CERT_PATH=/etc/letsencrypt/live/<domain>/fullchain.pem
#   TLS_KEY_PATH=/etc/letsencrypt/live/<domain>/privkey.pem
TLS_CERT_PATH=/etc/nginx/certs/tls.crt
TLS_KEY_PATH=/etc/nginx/certs/tls.key
# HSTS max-age seconds. 0 (dev/self-signed) neutralises the header so browsers
# do not pin an untrusted cert; production uses 63072000.
HSTS_MAX_AGE=0
# ACME contact for `certbot certonly` (real certs only; optional otherwise).
# ACME_EMAIL=ops@example.com
# In production the browser must reach the api through nginx (same origin) so
# the internal service name never leaks and cookies stay first-party:
#   NEXT_PUBLIC_API_URL=https://<SERVER_NAME>/api

# ─── Backup sidecar (ops profile; see docs/backup.md) ───────
# age public recipient used to encrypt every backup artifact. REQUIRED to
# start the `backup` service; its private key must live off-host.
# AGE_RECIPIENT=age1...
# Nightly schedule (cron syntax). Default 03:17 UTC.
BACKUP_CRON_SCHEDULE=17 3 * * *

# ─── Feature flags ──────────────────────────────────────────
NEXT_TELEMETRY_DISABLED=1
