// Career OS schema (P0 baseline). Additive per phase; every migration named + reviewed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.Citext
  displayName  String?
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  sessions        Session[]
  providerConfigs ProviderConfig[]
  integrations    Integration[]
  resumeFacts     ResumeFact[]
  careerGoals     CareerGoal?
  recoveryKeys    RecoveryKey[]
  auditEvents     AuditEvent[]
  llmCalls        LlmCall[]
  llmHallucinationLogs LlmHallucinationLog[]
  evidence        Evidence[]
  candidateSkillStates CandidateSkillState[]
  skillStateEvents SkillStateEvent[]
  setupState      SetupStateRow?
  attempts        Attempt[]
  xpEvents        XpEvent[]
  streak          Streak?
  remediationTasks RemediationTask[]
  bossBattles      BossBattle[]
  jobPreferences   UserJobPreferences?
  marketBriefs     MarketBrief[]
  marketSnapshots  MarketSnapshot[]
  resumeVariants   ResumeVariant[]
  coverLetters     CoverLetter[]
  applications     Application[]
  passkeyCredentials PasskeyCredential[]
  recoveryCodes    RecoveryCode[]
  passkeyChallenges PasskeyChallenge[]
  skillFacts       SkillFact[]
  factBase         FactBase[]
  agentDevices     AgentDevice[]
  gmailWatch       GmailWatch?
  gmailProcessed   GmailProcessedMessage[]
  approvalItems    ApprovalItem[]
  dailyBriefPreference DailyBriefPreference?
  inboxItems       InboxItem[]
  emailApplicationLinks EmailApplicationLink[]

  @@map("users")
}

/// E.7 (Wave E / P5): inbox triage row per inbound email.
/// `class` + `classConfidence` come from the E.5 classifier.
/// `linkedApplicationId` is set when the fuzzy matcher hits >= 0.85 or
/// the user manually links. `status`: new | linked | dismissed.
/// Composite unique on (userId, emailId) so re-ingest is idempotent.
model InboxItem {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  emailId             String   @map("email_id")
  fromAddress         String   @map("from_address")
  subject             String
  snippet             String?
  class               String
  classConfidence     Float    @map("class_confidence") @db.Real
  linkedApplicationId String?  @map("linked_application_id") @db.Uuid
  status              String   @default("new") /// new | linked | dismissed
  arrivedAt           DateTime @default(now()) @map("arrived_at") @db.Timestamptz(6)
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedApplication  Application?  @relation(fields: [linkedApplicationId], references: [id], onDelete: SetNull)
  links              EmailApplicationLink[]

  @@unique([userId, emailId])
  @@index([userId, status, arrivedAt(sort: Desc)])
  @@map("inbox_items")
}

/// E.7 soft link between an InboxItem and an Application. `confidence`
/// captured at link time; `by` = 'auto' when the matcher created it,
/// 'user' when a manual override wired it. `unlinkedAt` on unlink so
/// the audit trail survives.
model EmailApplicationLink {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  inboxItemId   String   @map("inbox_item_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  confidence    Float    @db.Real
  by            String   @default("auto")
  linkedAt      DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)
  unlinkedAt    DateTime? @map("unlinked_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboxItem   InboxItem   @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([inboxItemId, applicationId])
  @@index([userId, applicationId])
  @@map("email_application_links")
}

/// E.3 (Wave E / P5): daily-brief preferences. One row per user (PK = userId).
/// Absence = not yet configured = the scheduler treats as opted-out.
/// `sendHourLocal` (0-23) is in the user's IANA timezone; the scheduler
/// converts to UTC per enqueue so DST is respected. `channels` is a subset
/// of the ChannelKind union in @careeros/messaging.
model DailyBriefPreference {
  userId        String   @id @map("user_id") @db.Uuid
  isEnabled     Boolean  @default(true) @map("is_enabled")
  timezone      String   @default("UTC")
  sendHourLocal Int      @default(8) @db.SmallInt @map("send_hour_local")
  channels      String[] @default(["web"])
  snoozedUntil  DateTime? @map("snoozed_until") @db.Timestamptz(6)
  lastSentAt    DateTime? @map("last_sent_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
  @@map("daily_brief_preferences")
}

/// D.2 (P3.5 desktop companion): one row per paired desktop agent instance.
/// `publicKey` is the raw Ed25519/X25519/etc. public key bytes the agent
/// generated during pairing (agent keeps the private half in OS keychain).
/// `revokedAt` is a soft-delete: once set, every JWT-authed request is 401
/// and the WSS connection is dropped. `lastSeenAt` is bumped on WSS
/// heartbeat + task-result. `agentVersion` is reported by the agent on
/// connect so the server can force-upgrade stale builds.
model AgentDevice {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  name         String
  publicKey    Bytes
  pairedAt     DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  lastSeenAt   DateTime? @db.Timestamptz(6)
  agentVersion String?

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks    AgentTask[]
  sessions AgentSession[]

  @@index([userId])
  @@index([revokedAt])
  @@map("agent_devices")
}

/// D.2: queue of work the server pushes to a specific device over WSS.
/// `params` is a Zod-validated JSON payload (schema owned by
/// `packages/browser-agent`). `status` transitions:
///   queued → in_progress → (completed | failed | timeout)
/// `expiresAt` lets the dispatcher drop rows the device never picked up.
model AgentTask {
  id          String    @id @default(uuid()) @db.Uuid
  deviceId    String    @db.Uuid
  kind        String
  params      Json
  status      String    @default("queued")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  resultJson  Json?
  expiresAt   DateTime  @db.Timestamptz(6)

  device AgentDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@index([expiresAt])
  @@map("agent_tasks")
}

/// D.2: server-side JWT store. `jwtHash` is sha256(hex) of the issued token
/// so a leaked token can be revoked without waiting for TTL. One row per
/// issued (JWT + refresh) pair; refresh rotation deletes the old row and
/// inserts a new one. Refresh token hash lives in `refreshHash`.
model AgentSession {
  id           String    @id @default(uuid()) @db.Uuid
  deviceId     String    @db.Uuid
  jwtHash      String    @unique
  refreshHash  String    @unique
  issuedAt     DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)

  device AgentDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([expiresAt])
  @@map("agent_sessions")
}

/// D.2: short-lived pairing codes minted by `POST /agent/pair/start`.
/// `codeHash` is sha256(hex) of the 6-digit code (we never store plaintext).
/// A new start for the same user invalidates prior rows in the same tx.
model AgentPairingRequest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@map("agent_pairing_requests")
}

/// C-P0.7: registered WebAuthn credentials. One row per passkey per user.
/// `credentialId` is the base64url-decoded raw id bytes from the authenticator;
/// `publicKey` is the COSE key returned by @simplewebauthn/server. `counter`
/// starts at whatever the authenticator reports and monotonically increases;
/// a counter that fails to advance on login is a cloned-credential signal.
model PasskeyCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  credentialId Bytes    @unique /// raw credential id bytes
  publicKey    Bytes    /// COSE-encoded public key
  counter      BigInt   @default(0)
  transports   String[] @default([]) /// AuthenticatorTransportFuture[] as strings
  name         String?  /// user-supplied nickname ("Laptop", "iPhone")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  lastUsedAt   DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

/// C-P0.7: recovery codes for account access when passkeys are lost. Generated
/// as a set (typically 8); shown once to the user, then only sha256 hashes are
/// persisted. Redemption is atomic (compare-and-set on `usedAt`). Codes are
/// case-insensitive: input is uppercased + de-hyphenated before hashing.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique /// sha256 hex of the normalized plaintext code
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// C-P0.7: outstanding WebAuthn challenges. One row per in-flight
/// registration/authentication ceremony. Challenges expire after 5 min;
/// worker/cron can sweep, but the verify path also refuses expired rows.
/// `userId` nullable so usernameless auth flows work — the challenge is bound
/// to the browser via a short-lived server-side row keyed by the challenge
/// value itself. The plan says do not hand-roll CBOR/COSE — @simplewebauthn
/// owns that. This table just parks the challenge string until the browser
/// answers.
model PasskeyChallenge {
  challenge String   @id /// base64url string returned by @simplewebauthn
  userId    String?  @db.Uuid
  kind      String   /// "register" | "authenticate"
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("passkey_challenges")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Failed sign-in attempts, per (email, ip). Exponential lockout is derived from
/// the count of consecutive failures since the last success. Used by A-C1.
model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   /// normalized (NFC + lowercase)
  ip         String
  ok         Boolean  @default(false)
  reason     String?
  attemptedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([email, ip, attemptedAt])
  @@index([attemptedAt])
  @@map("login_attempts")
}

/// Active sealed-cookie sessions, keyed by the `sessionId` embedded in the cookie
/// payload (A-H3). Cookie is only accepted if a row exists AND its `iat` >=
/// `revokedBefore`. Password reset bumps `revokedBefore` in one write.
model ActiveSession {
  id         String   @id @db.Uuid /// random 128-bit sessionId written into the cookie payload
  userId     String   @db.Uuid
  issuedAt   DateTime @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime @db.Timestamptz(6)
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
  @@map("active_sessions")
}

/// Setup wizard state. One row per user (single-user default but multi-user-ready).
model SetupStateRow {
  userId       String   @id @db.Uuid
  state        String   @default("not_started")
  completedAt  DateTime? @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("setup_state")
}

/// Application-level config (non-sensitive). Sensitive values live in encrypted_secrets.
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("app_config")
}

/// Encrypted secret store (AES-GCM, master key from ENCRYPTION_KEY env).
model EncryptedSecret {
  id         String   @id @default(uuid()) @db.Uuid
  ownerType  String   /// "user" | "system"
  ownerId    String?  @db.Uuid
  purpose    String   /// e.g. "provider:deepseek:apiKey"
  ciphertext String   /// base64 iv+tag+ct
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@unique([ownerType, ownerId, purpose])
  @@map("encrypted_secrets")
}

model ProviderConfig {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  chatModel      String
  reasoningModel String?
  baseUrl        String?
  apiKeySecretId String   @db.Uuid /// references EncryptedSecret.id
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("provider_configs")
}

model Integration {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  kind         String   /// "github" | "gitlab" | "slack" | "gmail"
  status       String   @default("connected") /// "connected" | "revoked"
  tokenSecretId String? @db.Uuid
  /// Self-hosted host URL for kinds that support it (gitlab enterprise today).
  /// Always null for gitlab.com + github.com. Validated via `assertPublicUrl`
  /// + per-user host allowlist opt-in before persist (Wave A A-C2 / A-H6b).
  baseUrl      String?
  metadata     Json?
  connectedAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("integrations")
}

/// Verified facts from resume + user edits. Field-level encryption lands in P1.
model ResumeFact {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  kind      String   /// "employment" | "education" | "skill" | "cert" | "project" | "achievement"
  content   Json
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("resume_facts")
}

model CareerGoal {
  userId       String   @id @db.Uuid
  targetRoles  String[]
  locations    String[]
  remoteOnly   Boolean  @default(false)
  compMin      Int?
  compMax      Int?
  currency     String   @default("USD")
  seniority    String[]
  timezone     String
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_goals")
}

model RecoveryKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  hashPreview    String   /// last 4 chars for display; never store full key
  acknowledgedAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_keys")
}

/// Canonical skill catalog. Seeded from ESCO subset (see docs). `id` is a stable ESCO-derived slug.
/// C-P1.3: `escoId` is the canonical ESCO code where one exists, or `careeros:<slug>`
/// for skills ESCO does not cover. Unique so the seed can idempotently upsert.
/// `category` is the seed-time bucket (`language`, `framework`, `data`, `cloud`,
/// `devops`, `practice`); `cluster` remains the legacy field used by the aggregator.
model Skill {
  id          String   @id
  name        String
  cluster     String?  /// "language" | "framework" | "tool" | "domain" | "practice"
  category    String?  @default("uncategorized")
  escoId      String?  @unique
  escoUri     String?
  aliases     String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  evidence             Evidence[]
  candidateSkillStates CandidateSkillState[]
  skillFacts           SkillFact[]

  @@index([cluster])
  @@index([category])
  @@map("skills")
}

/// C-P1.3: per-user, per-skill claim log used by grounded generation. One row
/// per atomic assertion the user can make about a skill (evidence pointer,
/// self-declaration, certification, or commit-touch summary). Distinct from
/// `Evidence` (which is the aggregator's structured signal) — this table is
/// the user-editable + LLM-consumable "what can I say about this skill" list.
model SkillFact {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  skillId    String
  factType   String   /// 'evidence' | 'declaration' | 'certification' | 'commit_touch'
  claim      String   @db.Text
  sourceRef  String?
  verifiedAt DateTime? @db.Timestamptz(6)
  confidence Float    @default(0.5)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId, skillId])
  @@index([userId, factType])
  @@map("skill_facts")
}

/// C-P1.3: master fact base — subject/predicate/object triples the user can
/// stand behind. Consumed by resume-variants, cover-letters, dossier
/// grounded-generation to keep prose tied to a citable row. `factHash` is a
/// content hash so upserts stay idempotent; `source` is the origin (`github`,
/// `resume`, `manual`, ...) and `sourceRef` is the pointer inside that source.
model FactBase {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  factHash   String   @unique
  subject    String
  predicate  String
  object     String   @db.Text
  source     String
  sourceRef  String?
  verifiedAt DateTime? @db.Timestamptz(6)
  confidence Float    @default(0.5)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
  @@index([userId, predicate])
  @@map("fact_base")
}

/// Every atomic proof a candidate can point to. Immutable append-only.
/// `kind` = self | document | code | assessment | behavioral | outcome (weights in knowledge-rules.ts).
/// `signal` picks the aggregator rule (correct-independent, presence, sustained-application, ...).
model Evidence {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  skillId      String
  kind         String   /// evidence type; see EvidenceKind in shared/knowledge-rules.ts
  signal       String   /// EvidenceSignal; see knowledge-rules.ts RULE_BY_SIGNAL
  weightHint   Decimal? @db.Decimal(4, 3) /// optional per-evidence override [0..1]
  sourceRef    Json?    /// {kind: "resume_fact" | "repo" | "assessment" | ..., id: string}
  detail       Json?    /// free-form details for UI display
  observedAt   DateTime @default(now()) @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillStateEvents SkillStateEvent[]

  @@index([userId, skillId, observedAt])
  @@map("evidence")
}

/// Denormalised per-user, per-skill snapshot recomputed by the aggregator.
/// Never edited by hand; always derived from evidence[].
model CandidateSkillState {
  userId                 String   @db.Uuid
  skillId                String
  proficiency            Decimal  @db.Decimal(5, 2) /// [0..100]
  confidence             Decimal  @db.Decimal(4, 3) /// [0..1]
  recencyDays            Int      /// days since most recent evidence
  historicalDemonstrated Boolean  @default(false) /// monotonic: was ever proven
  evidenceCount          Int      @default(0)
  level                  Int      @default(1) /// derived level 1..100
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([userId, level])
  @@map("candidate_skill_state")
}

/// Append-only reason log for every skill-state change. Feeds the "why" panel in the UI.
model SkillStateEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  skillId     String
  evidenceId  String?  @db.Uuid /// nullable: rules like longInactivity fire from time, not evidence
  rule        String   /// which knowledge-rule fired
  reason      String
  beforeJson  Json?
  afterJson   Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([userId, skillId, timestamp])
  @@index([evidenceId])
  @@map("skill_state_events")
}

/// Grounded-generation hallucination log. One row per suspicious output.
/// Feeds the eval loop. Retention: 30 days via `hallucination-log-retention`
/// worker (A-M4). `snippet` carries the raw source-text excerpt so an
/// eval-review UI can show "did the model hallucinate this?" — encrypted at
/// rest via ENCRYPTED_FIELDS in prisma.service.ts. `snippetHash` +
/// `snippetOffset` are the low-privilege identifiers: same source produces
/// the same hash + offset so eval-only paths never need to touch plaintext.
model LlmHallucinationLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @db.Uuid
  llmCallId         String?  @db.Uuid
  promptId          String
  promptVersion     String
  promptHash        String
  suspectFragments  String[] @default([])
  detail            Json?
  snippet           String?  /// encrypted at rest (ENCRYPTED_FIELDS: LlmHallucinationLog.snippet)
  snippetHash       String?  /// sha256 hex of the raw source text (32 chars = 128 bits truncated)
  snippetOffset     Json?    /// {start:number, end:number} byte offsets into the source
  timestamp         DateTime @default(now()) @db.Timestamptz(6)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  llmCall LlmCall? @relation(fields: [llmCallId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([promptId, timestamp])
  @@index([llmCallId])
  @@map("llm_hallucination_log")
}

/// Per-call audit + cost accounting for every provider LLM invocation.
/// Non-blocking write; ok to lose a row under crash. Retention: 90 days (enforced by cron in P6).
model LlmCall {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @db.Uuid
  provider         String   /// "deepseek" | future
  model            String
  callKind         String   /// "chat" | "chatStructured" | "test:chat" | "test:structured" | "test:tools" | "test:streaming"
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  costUsd          Decimal? @db.Decimal(10, 6)
  latencyMs        Int
  ok               Boolean
  error            String?
  timestamp        DateTime @default(now()) @db.Timestamptz(6)

  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  hallucinationLogs LlmHallucinationLog[]

  @@index([userId, timestamp])
  @@index([timestamp])
  @@map("llm_calls")
}

/// Append-only audit log. Insert-only in application; no UPDATE/DELETE granted to app role.
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  actor        String   /// "user" | "system" | "agent:<role>"
  action       String
  resourceType String?
  resourceId   String?
  payload      Json?
  ip           String?
  userAgent    String?
  timestamp    DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@map("audit_log")
}

/// Reusable + LLM-generated question pool. One row per canonical variant.
/// Slice 1 uses hand-seeded rows; slice 2 wires the question-generator agent.
model Question {
  id                 String   @id @default(uuid()) @db.Uuid
  kind               String   /// "knowledge" | (coding | debugging | etc. land in slices 2+)
  skillIds           String[] /// FK-shaped but not enforced; skill catalogue is ID-stable
  difficulty         String   /// "easy" | "medium" | "hard"
  prompt             String
  keyPoints          String[] /// slice-1 rule-based grader match target
  answerHint         String?
  promptHash         String   @unique
  flagged            Boolean  @default(false)
  /// Source attribution (slice 12). Null for LLM-generated rows. When set,
  /// runners must display sourceAttribution + link to satisfy license terms.
  sourceKind         String?  /// e.g. "system-design-primer" | "tech-interview-handbook"
  sourceUrl          String?
  sourceAttribution  String?  /// human-readable credit line rendered under the question
  /// C-P2.7e: Qdrant point id for the embedding of `prompt`. Populated by the
  /// weekly corpus refresh worker so near-duplicate lookups can skip a re-encode.
  /// Null on LLM-generated rows (embedding is not indexed there).
  embeddingId        String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  attempts Attempt[]

  @@index([kind, difficulty])
  @@index([sourceKind])
  @@map("question_bank")
}

/// One row per submission of any assessment (slice 1: knowledge only).
/// Attempt drives evidence + xp + streak side effects.
model Attempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  questionId    String?  @db.Uuid
  kind          String   /// mirrors Question.kind
  score         Decimal  @db.Decimal(4, 3) /// [0..1]
  reasoning     String?
  answerJson    Json?
  gradingJson   Json?
  durationMs    Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  xpEvents XpEvent[]

  @@index([userId, createdAt])
  @@map("attempts")
}

/// Append-only XP ledger. `xp` may be negative for future penalty rules.
model XpEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  attemptId String?  @db.Uuid
  reason    String   /// "attempt:knowledge" | "streak:milestone" | ...
  xp        Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt Attempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("xp_events")
}

/// One row per user. Recomputed on every attempt via pure `streakTick`.
model Streak {
  userId          String   @id @db.Uuid
  currentDays     Int      @default(0)
  longestDays     Int      @default(0)
  lastAttemptDate DateTime? @db.Date
  graceRemaining  Int      @default(2)
  graceResetsAt   DateTime @db.Date
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

/// One open task per (user, skill) when the aggregator detects repeated failure.
/// Closed either by the user marking it done or by a subsequent passing attempt
/// on the same skill (auto-close in `gradeKnowledgeAttempt`).
model RemediationTask {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  skillId         String
  reason          String
  status          String   @default("open") /// "open" | "closed"
  sourceAttemptIds String[] @default([])
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  closedAt        DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial-unique index (`... WHERE status = 'open'`) lives in the migration
  // SQL because Prisma DSL doesn't express partial indexes. Result: at most
  // ONE open task per (user, skill); multiple closed rows are fine.
  @@index([userId, status])
  @@map("remediation_tasks")
}

/// Per-user weekly market brief. Generated on demand (walking-skeleton) from
/// stats computed against jobs the user's prefs would show. Content is LLM
/// prose grounded in the stats + sources list.
model MarketBrief {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  generatedAt  DateTime @default(now()) @db.Timestamptz(6)
  windowStart  DateTime @db.Timestamptz(6)
  windowEnd    DateTime @db.Timestamptz(6)
  statsJson    Json     /// {topSkills, topCompanies, newCount, totalCount, remoteShare, ...}
  content      String   @db.Text
  sourcesJson  Json     /// [{kind, ref, url}]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt(sort: Desc)])
  @@map("market_briefs")
}

/// C-P3.4: weekly persisted stats snapshot per (user × filterHash). One row per
/// (day, filterHash) - the unique index below is on the truncated snapshot day
/// (see migration SQL) + filterHash so a manual retry on the same day doesn't
/// double-write. `filterHash` is a stable SHA-256 of the pref set (see
/// `snapshot.service.ts::hashFilter`) so per-user prefs get their own timeline
/// while a shared preset (all-jobs-fresh-45d) shares one across users.
/// `statsJson` is the same shape as MarketBrief.statsJson - reuses computeStatsFn.
model MarketSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @db.Uuid /// null when snapshot is the shared default filter (cron only)
  snapshotAt  DateTime @default(now()) @db.Timestamptz(6)
  filterHash  String   /// sha-256 hex of the pref set that produced statsJson
  statsJson   Json     /// {topSkills, topCompanies, newCount, totalCount, remoteShare, ...}
  createdBy   String   @default("cron") /// 'cron' | 'manual'

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, snapshotAt(sort: Desc)])
  @@index([filterHash, snapshotAt(sort: Desc)])
  @@map("market_snapshots")
}

/// Per-user job-search preferences. Drives Stage 7 (relevance filter) of the
/// job pipeline: excludes anything that violates the user's hard rules before
/// match scoring. Walking-skeleton uses lists only — role classification and
/// comp-band comparison land when the analysis slice ships.
model UserJobPreferences {
  userId             String   @id @db.Uuid
  targetRoles        String[] @default([]) /// free-text, matched when role classifier ships
  locations          String[] @default([]) /// free-text city/country
  remoteOnly         Boolean  @default(false)
  compMin            Int?     /// annualized in currency below
  compMax            Int?
  currency           String   @default("USD") @db.Char(3)
  seniority          String[] @default([]) /// intern | junior | mid | senior | staff | principal | manager
  mustHaveSkills     String[] @default([]) /// skill IDs from catalogue; job must have all
  dealbreakerSkills  String[] @default([]) /// skill IDs; job with any of these gets excluded
  companyBlacklist   String[] @default([]) /// case-insensitive company names
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_job_preferences")
}

/// Append-only raw job fetches. One row per (source, sourceId, fetchedAt).
/// Never overwritten — normalization derives from these. Global (not
/// user-scoped) because ingestion is system-wide; filtering happens downstream.
model JobRaw {
  id            String   @id @default(uuid()) @db.Uuid
  source        String   /// adapter id, e.g. "remotive"
  sourceId      String   /// adapter's stable id for the job posting
  canonicalUrl  String   /// URL to the job (used for cross-source dedupe)
  payload       Json     /// full raw payload as returned by the adapter
  fetchedAt     DateTime @default(now()) @db.Timestamptz(6)

  @@index([source, sourceId, fetchedAt])
  @@index([canonicalUrl])
  @@map("jobs_raw")
}

/// Canonical job row (one per unique canonicalUrl for walking-skeleton).
/// Skill extraction, verification state machine, relevance filter, match
/// score all land in later slices — for now state defaults to "unverified"
/// and no scoring exists.
/// Job-tailored resume variant. Content is a structured shape (summary +
/// sections + bullets with factRefs), rendered to markdown/PDF/DOCX later.
/// `factRefs` on each bullet points at `ResumeFact.id`s the LLM used so
/// generation is grounded and auditable.
model ResumeVariant {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  jobId        String?  @db.Uuid /// nullable so a variant can outlive the job row
  roleTarget   String
  templateId   String   @default("ats-first")
  contentJson  Json
  factRefs     String[] @default([]) /// all fact IDs cited across the variant
  parentId     String?  @db.Uuid /// prior variant this was cloned from
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("resume_variants")
}

/// Per-user job application. State machine lives in `packages/shared/src/
/// applications.ts` (guards in service). `resumeVariantId` + `coverLetterId`
/// point at the artifacts the user attached; both nullable so a user can
/// track a job without generating docs yet. Unique on (userId, jobId) —
/// tracking the same job twice is a data error, not a UX intent.
model Application {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  jobId           String   @db.Uuid
  state           String   @default("interested") /// interested | applied | interviewing | offer | rejected | ghosted
  appliedAt       DateTime? @db.Timestamptz(6)
  resumeVariantId String?  @db.Uuid
  coverLetterId   String?  @db.Uuid
  notes           String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ApplicationEvent[]
  emailApplicationLinks EmailApplicationLink[]
  inboxItems InboxItem[]

  @@unique([userId, jobId])
  @@index([userId, state])
  @@map("applications")
}

/// Append-only transition log for applications. One row per state change,
/// including the initial `null → interested` transition at create time.
model ApplicationEvent {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid
  fromState     String?  /// null on the very first row (creation event)
  toState       String
  byActor       String   @default("user") /// user | system | agent
  notes         String?
  at            DateTime @default(now()) @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, at])
  @@map("application_events")
}

/// Job-tailored cover letter. Sibling of ResumeVariant — same grounded-
/// generation + fact-check pattern, but per-paragraph instead of per-bullet.
/// `contentJson` stores `{content, audit}` wrapper (same shape as resume).
model CoverLetter {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  jobId        String?  @db.Uuid
  roleTarget   String
  templateId   String   @default("standard")
  contentJson  Json
  factRefs     String[] @default([])
  parentId     String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("cover_letters")
}

model NormalizedJob {
  id              String   @id @default(uuid()) @db.Uuid
  canonicalUrl    String   @unique
  title           String
  company         String
  location        String?
  remote          Boolean  @default(false)
  description     String   @db.Text
  sourcePostedAt  DateTime? @db.Timestamptz(6)
  primarySource   String   /// adapter id currently owning this row
  sourceIds       String[] @default([]) /// adapter id + sourceId pairs for provenance
  state           String   @default("unverified") /// unverified | verified | discovered | stale | closed
  /// LLM-extracted skill IDs (from `Skill.id` catalogue). Empty = not yet
  /// processed. `skillsExtractedAt` records when the extraction ran so a
  /// re-run can prefer unprocessed rows first.
  skillIds        String[] @default([])
  skillsExtractedAt DateTime? @db.Timestamptz(6)
  firstSeenAt     DateTime @default(now()) @db.Timestamptz(6)
  lastVerifiedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([primarySource])
  @@index([sourcePostedAt(sort: Desc)])
  @@index([skillIds], type: Gin)
  @@map("jobs_normalized")
}

/// Boss battles: milestone-triggered timed challenges. One `active` row per
/// user at a time; partial-unique on (userId, milestone) WHERE status='passed'
/// (migration SQL) so a user can retry a milestone after failing/expiring but
/// can only pass each milestone once.
model BossBattle {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  milestone    Int       /// 10 | 25 | 50 | 75 | 100
  startedAt    DateTime  @default(now()) @db.Timestamptz(6)
  durationS    Int       @default(1800) /// 30 min default
  submittedAt  DateTime? @db.Timestamptz(6)
  score        Decimal?  @db.Decimal(4, 3)
  status       String    @default("active") /// "active" | "passed" | "failed" | "expired"
  questionIds  String[]  @default([])
  attemptIds   String[]  @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("boss_battles")
}

/// C-P4.4 company dossier. One row per company (`companyId` is the free-form
/// company name — no Company table yet, matches `NormalizedJob.company`).
/// Every JSON field is a snapshot of one pipeline stage; `synthesis` is the
/// grounded LLM narrative, and `factRefs` lists the fact ids the LLM cited.
/// Cache invariant: rows are re-used until `staleAfter` passes; `assembleFor`
/// short-circuits before hitting any external stage while still fresh.
model CompanyDossier {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @unique
  identity       Json     /// { website, linkedinUrl, employeeCount?, hq? }
  techSignals    Json     /// { stackHints: string[], engineeringBlogPosts: [{url,title,summary}] }
  reviews        Json     /// { ambitionbox?, comparably?, reddit?: {threads:[]} }
  interviews     Json     /// { leetcodeDiscuss?: [], glassdoorScraped?: [] }
  recentEvents   Json     /// { fundingRounds:[], layoffs:[], productLaunches:[], acquisitions:[] }
  synthesis      String   @db.Text
  factRefs       String[] @default([])
  generatedAt    DateTime @default(now()) @db.Timestamptz(6)
  staleAfter     DateTime @db.Timestamptz(6)

  @@index([staleAfter])
  @@map("company_dossiers")
}

/// C-P3.2d: per-verify-rejection audit row.
/// Written whenever the verify stage returns verdict='rejected' during a
/// sync. Powers the reject-audit admin UI (deferred to web wave) and the
/// re-verify POST endpoint that lets an operator promote a fixed row back
/// into `jobs_normalized`.
///
/// `details.rawJd` carries the full job description so an operator can
/// inspect and reason about the rejection without cross-referencing
/// `jobs_raw`. Retention: none today (single-user MVP); a cleanup worker
/// lands with the reject-log UI slice.
model JobRejectLog {
  id           String   @id @default(uuid()) @db.Uuid
  /// FK-shaped only — `jobs_raw` never deletes rows so a hard FK would
  /// prevent expiry cleanup. String not @db.Uuid because the reject may
  /// come from a non-adapter source (email alert, agent) with no raw row.
  jobRawId     String?  @db.Uuid
  sourceId     String   /// adapter's stable id for the job posting
  sourceName   String   /// adapter id (e.g. "remotive")
  rejectedAt   DateTime @default(now()) @db.Timestamptz(6)
  /// Primary reason code (first entry from verify.reasons). Full list lives
  /// in `details.reasons`. Indexed so the admin filter (`?reason=`) is fast.
  reason       String
  /// Copy of the verify verdict at rejection time. Always 'rejected' today
  /// but stored explicitly so a future promotion to `flagged`-only logging
  /// doesn't require a schema change.
  verdict      String   @default("rejected")
  /// { reasons: string[], rawJd: string, canonicalUrl: string, title: string, company: string, ... }
  details      Json

  @@index([rejectedAt(sort: Desc)])
  @@index([sourceName, rejectedAt(sort: Desc)])
  @@index([reason, rejectedAt(sort: Desc)])
  @@map("job_reject_log")
}

/// E.4: one row per Gmail-connected user. Tracks the last-seen Gmail
/// `historyId` so `history.list` diffs are cheap + resumable, plus the watch
/// `expiration` (Gmail auto-expires 7 days after `users.watch`, so the daily
/// renewal cron re-arms anything within 24h of expiry).
model GmailWatch {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  historyId    String   /// Gmail returns a uint64, stored as string to dodge JS precision.
  expiration   DateTime @db.Timestamptz(6) /// watch auto-expiry (ms epoch converted).
  topicName    String   /// projects/<gcp>/topics/<topic> - stored for audit + renewal
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  renewedAt    DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiration])
  @@map("gmail_watches")
}

/// E.4: dedupe table. Pub/Sub is at-least-once and the history.list diff can
/// re-yield the same messageId across overlapping pushes. First insert wins;
/// duplicates hit the unique index and are treated as no-ops.
model GmailProcessedMessage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  messageId    String   /// Gmail message id (opaque)
  threadId     String?
  receivedAt   DateTime @db.Timestamptz(6) /// Gmail internalDate parsed to timestamp
  processedAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, processedAt(sort: Desc)])
  @@map("gmail_processed_messages")
}

/// F.1 (P6 controlled execution): every outbound action an agent wants to take
/// lands here first. The user approves + only then does the consumer submit.
/// State machine lives in `apps/api/src/modules/approvals/state-machine.ts`
/// (plain object of legal transitions - no XState, spec limits XState to the
/// job-application pipeline).
///
/// `kind` picks the downstream consumer; `payload` is the full tool invocation
/// the agent proposed; `diffJson` is what the UI shows to the user (a summary
/// of what will change - email body preview, target ATS + fields, Slack DM
/// text, etc.). `state` transitions:
///   pending -> approved -> (sent | failed)
///   pending -> cancelled
/// `failedReason` is set alongside the `failed` transition; `decidedAt` is
/// stamped on approve / cancel; `sentAt` on markSent.
model ApprovalItem {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  kind         String    /// 'ats_submit' | 'agent_form_fill' | 'outreach_email' | 'slack_dm' | 'delete_account'
  payload      Json      /// full tool invocation payload + agent reasoning
  diffJson     Json      /// user-facing preview of what will happen
  state        String    @default("pending") /// 'pending' | 'approved' | 'sent' | 'failed' | 'cancelled'
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  decidedAt    DateTime? @db.Timestamptz(6)
  sentAt       DateTime? @db.Timestamptz(6)
  failedReason String?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ApprovalEvent[]

  @@index([userId, state, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("approval_items")
}

/// F.1: audit trail per approval item. One row per transition or notable
/// side-event (enqueued, approved, cancelled, sent, failed, bulk_reauth_required).
/// `actor` is `user` for user decisions, `system` for consumer-worker markSent /
/// markFailed. `meta` carries the request-scoped extras (reason for cancel,
/// consumer id for markSent, error snippet for markFailed).
model ApprovalEvent {
  id             String   @id @default(uuid()) @db.Uuid
  approvalItemId String   @db.Uuid
  event          String
  actor          String   @default("user") /// 'user' | 'system' | 'agent'
  meta           Json?
  at             DateTime @default(now()) @db.Timestamptz(6)

  item ApprovalItem @relation(fields: [approvalItemId], references: [id], onDelete: Cascade)

  @@index([approvalItemId, at])
  @@map("approval_events")
}
