# Dev-oriented image. Mirrors Dockerfile.api. Production hardening lands in P6.
FROM node:20-alpine

RUN apk add --no-cache libc6-compat openssl wget

# Non-root UID 1001:1001 (matches Dockerfile.api and MinIO's bitnami user).
# Owns /app so install + prisma generate run as the same user the container
# boots as; prod compose layers a read-only rootfs + tmpfs on top.
RUN addgroup -g 1001 -S careeros \
 && adduser -u 1001 -S careeros -G careeros -h /app -s /sbin/nologin

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

WORKDIR /app
RUN chown -R careeros:careeros /app

USER careeros

COPY --chown=careeros:careeros package.json pnpm-lock.yaml* pnpm-workspace.yaml turbo.json tsconfig.base.json ./
# W15-B temporary: full workspace copy so pnpm resolves every workspace:* dep.
COPY --chown=careeros:careeros . .

RUN pnpm install --frozen-lockfile || pnpm install

# Worker reads through the same Prisma client the api generates.
RUN pnpm --filter @careeros/api prisma generate

CMD ["pnpm", "--filter", "@careeros/worker", "start"]
