# Dev-oriented image, hardened to satisfy security.md item 10 for prod runs.
# ponytail: single-stage alpine kept (not distroless) because the dev
# compose override calls `pnpm dev` which needs a shell + pnpm; distroless
# has neither. Non-root UID + read-only rootfs + cap-drop land in compose
# where they can be toggled off by the dev override without rebuilding.
# Upgrade path: a second `FROM gcr.io/distroless/nodejs20-debian12` runtime
# stage for prod images when we split dev and prod Dockerfiles.
FROM node:20-alpine

RUN apk add --no-cache libc6-compat openssl wget age

# Non-root UID 1001:1001 (matches the convention we already use for MinIO's
# bitnami user). Owns /app so install + prisma generate run as the same user
# that the container boots as. ponytail: fixed UID (not dynamic from host)
# because dev bind-mounts are reconciled by the compose override which flips
# USER back to root; prod uses only this UID.
RUN addgroup -g 1001 -S careeros \
 && adduser -u 1001 -S careeros -G careeros -h /app -s /sbin/nologin

RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

WORKDIR /app
RUN chown -R careeros:careeros /app

USER careeros

COPY --chown=careeros:careeros package.json pnpm-lock.yaml* pnpm-workspace.yaml turbo.json tsconfig.base.json ./
# W15-B temporary: full workspace copy so pnpm resolves every workspace:* dep and
# apps/api's prisma-generate postinstall sees apps/api/prisma/schema.prisma.
COPY --chown=careeros:careeros . .

RUN pnpm install --frozen-lockfile || pnpm install

RUN pnpm --filter @careeros/api prisma generate

EXPOSE 3001

CMD ["pnpm", "--filter", "@careeros/api", "start:prod"]
